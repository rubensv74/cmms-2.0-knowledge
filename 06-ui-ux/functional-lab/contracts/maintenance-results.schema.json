{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmms2-maintenance-results.schema.json",
  "title": "CMMS 2.0 Maintenance Results",
  "type": "object",
  "required": ["maintenanceResults", "actualMaintenanceCosts", "effectivenessReviews"],
  "properties": {
    "maintenanceResults": { "type": "array", "items": { "$ref": "#/$defs/maintenanceResult" } },
    "actualMaintenanceCosts": { "type": "array", "items": { "$ref": "#/$defs/actualMaintenanceCost" } },
    "effectivenessReviews": { "type": "array", "items": { "$ref": "#/$defs/effectivenessReview" } }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": ["fieldId", "value"],
      "properties": {
        "fieldId": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "unit": { "type": ["string", "null"] },
        "capturedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "additionalProperties": false
    },
    "maintenanceResult": {
      "type": "object",
      "required": ["maintenanceResultId", "executionPlanTaskId", "executedAt", "outcome"],
      "properties": {
        "maintenanceResultId": { "type": "string", "minLength": 1 },
        "executionPlanTaskId": { "type": "string", "minLength": 1 },
        "executedAt": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "measurements": { "type": "array", "items": { "$ref": "#/$defs/measurement" } },
        "findings": { "type": "array", "items": { "type": "string" } },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "actualMaintenanceCost": {
      "type": "object",
      "required": ["actualMaintenanceCostId", "maintenanceResultId", "currency", "totalCost"],
      "properties": {
        "actualMaintenanceCostId": { "type": "string", "minLength": 1 },
        "maintenanceResultId": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 },
        "laborCost": { "type": "number" },
        "materialCost": { "type": "number" },
        "otherCost": { "type": "number" },
        "totalCost": { "type": "number" },
        "costBasisDate": { "type": "string" },
        "sourceRef": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "effectivenessReview": {
      "type": "object",
      "required": ["effectivenessReviewId", "fmeaAssetApplicationId", "decision", "status"],
      "properties": {
        "effectivenessReviewId": { "type": "string", "minLength": 1 },
        "fmeaAssetApplicationId": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "observations": { "type": "string" },
        "engineeringChangeRequestId": { "type": ["string", "null"] },
        "status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
