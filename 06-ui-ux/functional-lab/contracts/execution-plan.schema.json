{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmms2-execution-plan.schema.json",
  "title": "CMMS 2.0 Execution Plan",
  "type": "object",
  "required": ["executionPlanId", "fmeaAssetApplicationId", "revisionNumber", "status", "tasks"],
  "properties": {
    "executionPlanId": { "type": "string", "minLength": 1 },
    "fmeaAssetApplicationId": { "type": "string", "minLength": 1 },
    "revisionNumber": { "type": ["string", "integer"] },
    "status": { "type": "string", "minLength": 1 },
    "effectiveFrom": { "type": ["string", "null"] },
    "effectiveTo": { "type": ["string", "null"] },
    "planningPolicyRef": { "type": ["string", "null"] },
    "publishedSnapshotId": { "type": ["string", "null"] },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/executionPlanTask" } },
    "maintenanceCostEstimates": { "type": "array", "items": { "$ref": "#/$defs/planCostEstimate" } }
  },
  "$defs": {
    "executionPlanTask": {
      "type": "object",
      "required": ["executionPlanTaskId", "maintenanceTaskId", "scope"],
      "properties": {
        "executionPlanTaskId": { "type": "string", "minLength": 1 },
        "maintenanceTaskId": { "type": "string", "minLength": 1 },
        "intervalValue": { "type": ["number", "null"] },
        "intervalUnit": { "type": ["string", "null"] },
        "triggerBasis": { "type": ["string", "null"] },
        "triggerValue": { "type": ["string", "number", "null"] },
        "intervalOverrideReason": { "type": ["string", "null"] },
        "discipline": { "type": "string" },
        "workCenter": { "type": "string" },
        "crew": { "type": "integer", "minimum": 0 },
        "tools": { "type": "string" },
        "spares": { "type": "string" },
        "shutdown": { "type": "string" },
        "permit": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "grouping": { "type": "string" },
        "procedureRef": { "type": ["string", "null"] },
        "inspectionFormatRef": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "planCostEstimate": {
      "type": "object",
      "required": ["maintenanceCostEstimateId", "currency", "estimatedAnnualCost"],
      "properties": {
        "maintenanceCostEstimateId": { "type": "string", "minLength": 1 },
        "sourceEstimateRef": { "type": ["string", "null"] },
        "currency": { "type": "string", "minLength": 1 },
        "estimatedCostPerRun": { "type": "number" },
        "estimatedRunsPerYear": { "type": "number" },
        "estimatedAnnualCost": { "type": "number" },
        "validationStatus": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
