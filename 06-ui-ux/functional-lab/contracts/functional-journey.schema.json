{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cmms2-functional-journey.schema.json",
  "title": "CMMS 2.0 Functional Journey v2",
  "type": "object",
  "required": ["version", "journeyId", "stages"],
  "properties": {
    "version": { "type": "string" },
    "journeyId": { "type": "string" },
    "name": { "type": "string" },
    "stages": {
      "type": "array",
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "ruleStatus": {
      "type": "string",
      "enum": ["hypothesis", "proposed", "to_validate", "validated", "approved", "superseded"]
    },
    "responsibilityType": {
      "type": "string",
      "enum": ["existing_input", "user_input", "system_calculation", "system_recommendation", "human_decision", "gate", "output"]
    },
    "layer": {
      "type": "string",
      "enum": ["library", "asset_application", "execution_plan", "results"]
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string" },
        "type": { "$ref": "#/$defs/responsibilityType" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "objectType": { "type": ["string", "null"] },
        "ruleId": { "type": ["string", "null"] },
        "required": { "type": "boolean" },
        "ruleStatus": { "$ref": "#/$defs/ruleStatus" }
      },
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "required": ["stageId", "phaseId", "workspaceId", "layer", "primaryObjectType", "title", "businessQuestion", "items", "ruleStatus"],
      "properties": {
        "stageId": { "type": "string", "pattern": "^FL-[0-9]{2}$" },
        "phaseId": { "type": "string", "pattern": "^P-[1-5]$" },
        "workspaceId": { "type": "string", "pattern": "^WS-[0-9]{2}$" },
        "layer": { "$ref": "#/$defs/layer" },
        "primaryObjectType": { "type": "string" },
        "title": { "type": "string" },
        "businessQuestion": { "type": "string" },
        "ownerRole": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        },
        "nextStageId": { "type": ["string", "null"] },
        "ruleStatus": { "$ref": "#/$defs/ruleStatus" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
